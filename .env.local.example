# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smarthubdb?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET=replace_with_a_long_random_secret

# Point the frontend to the built-in Next.js API routes
NEXT_PUBLIC_API_BASE_URL=/api

# Contact form (Resend) — get your key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Email address that receives custom plan requests
CONTACT_EMAIL=info@hasaanai.com

# Verified sending identity in Resend (do NOT use the example address until verified)
CONTACT_FROM_EMAIL=SmartSMBHub <audit@smartsmbhub.com>

# Optional: public EMBED URL of your published native Notion audit form.
# When set, /contact embeds that form instead of the Resend email form.
# Ensure form can accept submissions while the response database remains private.
NOTION_AUDIT_FORM_URL=

# Optional: Google Search Console HTML verification token, not the entire tag.
GOOGLE_SITE_VERIFICATION=

# Digital storefront: keep false until paid files, terms and delivery are tested.
DIGITAL_STORE_LIVE=false
# Public provider product-checkout URLs, NOT secret keys. Prices must match your approved catalog.
PAYMENT_LINK_PROMPT_DIARY=
PAYMENT_LINK_AI_FOUNDATIONS=
PAYMENT_LINK_MAKE_KIT=
PAYMENT_LINK_AI_BUNDLE=
