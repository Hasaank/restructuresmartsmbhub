# Website inquiry delivery. Keep all secret values server-side in Vercel settings.
# Required for the built-in form to become enabled:
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
# CONTACT_FROM_EMAIL must be a sending identity verified with Resend.
# Example FORMAT only: SmartSMBHub <audit@your-verified-domain.com>

# Optional alternative: a published, publicly submittable Notion form embed URL.
# When valid and configured, this replaces the built-in email form on /contact.
NOTION_AUDIT_FORM_URL=

# Optional HTTPS booking link. No booking button is shown until configured.
BOOKING_URL=
# Optional Google Search Console HTML verification value, not the full tag.
GOOGLE_SITE_VERIFICATION=
# Set true to prevent indexing outside production. Vercel preview deploys also noindex automatically.
NEXT_PUBLIC_NOINDEX=false

# Existing client-account/dashboard features. Not required for marketing pages or Resend contact delivery.
# Set these only if you operate and test those existing features.
MONGODB_URI=
JWT_SECRET=
NEXT_PUBLIC_API_BASE_URL=/api

# Storefront is paused and not promoted. Do not enable until separately tested.
DIGITAL_STORE_LIVE=false
PAYMENT_LINK_PROMPT_DIARY=
PAYMENT_LINK_AI_FOUNDATIONS=
PAYMENT_LINK_MAKE_KIT=
PAYMENT_LINK_AI_BUNDLE=
